# What each agent is working on right now. The agent subspace is the
# write-ownership contract: one agent writes its own folder, and reads from
# anywhere. This view is the read side of that.
filters:
  and:
    - 'file.ext == "md"'
    - 'file.inFolder("_agent-")'
formulas:
  age_days: '(now() - file.mtime).days'
properties:
  note.type:
    displayName: "Type"
  note.status:
    displayName: "Status"
  note.agent:
    displayName: "Agent"
  note.updated:
    displayName: "Updated"
  file.folder:
    displayName: "Subspace"
  formula.age_days:
    displayName: "Age (days)"
views:
  - type: table
    name: "Agent live state"
    groupBy:
      property: note.agent
      direction: ASC
    sort:
      - property: file.name
        direction: ASC
    order:
      - file.name
      - agent
      - type
      - status
      - file.folder
      - formula.age_days
  - type: table
    name: "Active"
    filters:
      and:
        - 'status == "active"'
    order:
      - file.name
      - agent
      - status
      - file.folder
  - type: table
    name: "Dormant subspaces"
    filters:
      and:
        - 'formula.age_days > 30'
    sort:
      - property: formula.age_days
        direction: DESC
    order:
      - file.name
      - agent
      - file.folder
      - formula.age_days
    limit: 40
    description: "Nothing touched in a month. A signal for consolidation, not a verdict."
